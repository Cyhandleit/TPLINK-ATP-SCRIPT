# TP-Link ATP 环境变量模板
# 复制为 .env 并填入真实值；不要将 .env 提交到版本控制。
# 警告：下方仅为占位符，请勿将真实密码写入仓库。

# ---------- 路由器网关 ----------
ATP_GATEWAY_IP=192.168.1.1
ATP_GATEWAY_SCHEME=http
ATP_ADMIN_USER=admin
ATP_ADMIN_PASS=***
ATP_SUPERADMIN_USER=superadmin
ATP_SUPERADMIN_PASS=***

# ---------- 宿主机网卡（Linux 常用 eth0/wlan0；Windows 请改为 Ethernet/Wi-Fi） ----------
ATP_LAN_IFACE=eth0
ATP_WIFI_IFACE=wlan0
ATP_EXT_NIC_IP=192.168.43.100

# ---------- 测试行为 ----------
ATP_PING_SECONDS=300
ATP_RUN_DESTRUCTIVE=false
ATP_HEADED=false
ATP_DEBUG=0

# ---------- WiFi 密码（如需 WiFi 用例，取消注释并填入真实值） ----------
# ATP_WIFI_24G_PASS=***
# ATP_WIFI_5G_PASS=***
# ATP_WIFI_6G_PASS=***
# ATP_WIFI_GUEST_PASS=***
# ATP_WIFI_MLO_PASS=***
