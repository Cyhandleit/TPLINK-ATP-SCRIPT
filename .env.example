# TP-Link ATP environment variables template
# Copy to .env and fill in real values; do not commit .env to version control.
# Warning: the following are placeholders only; do not write real passwords into the repository.

# ---------- Router Gateway ----------
ATP_GATEWAY_IP=192.168.1.1
ATP_GATEWAY_SCHEME=http
ATP_ADMIN_USER=admin
ATP_ADMIN_PASS=***
ATP_SUPERADMIN_USER=superadmin
ATP_SUPERADMIN_PASS=***

# ---------- Host NIC (Linux commonly eth0/wlan0; Windows please change to Ethernet/Wi-Fi) ----------
ATP_LAN_IFACE=eth0
ATP_WIFI_IFACE=wlan0
ATP_EXT_NIC_IP=192.168.43.100

# ---------- Test Behavior ----------
ATP_PING_SECONDS=300
ATP_RUN_DESTRUCTIVE=false
ATP_HEADED=false
ATP_DEBUG=0

# ---------- WiFi Passwords (if WiFi test cases needed, uncomment and fill in real values) ----------
# ATP_WIFI_24G_PASS=***
# ATP_WIFI_5G_PASS=***
# ATP_WIFI_6G_PASS=***
# ATP_WIFI_GUEST_PASS=***
# ATP_WIFI_MLO_PASS=***
